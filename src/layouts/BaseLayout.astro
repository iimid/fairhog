---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const pathname = Astro.url.pathname;
const isJapanese = pathname === "/ja" || pathname.startsWith("/ja/");
const productsHref = isJapanese ? "/ja/product/" : "/product/";
---

<html lang={isJapanese ? "ja" : "en-US"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system,
          BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f7f7f5;
        color: #171717;
      }

      :global(body) {
        margin: 0;
        line-height: 1.7;
      }

      header {
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 5vw;
        background: rgba(247, 247, 245, 0.9);
        border-bottom: 1px solid #e5e5e2;
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(12px);
      }

      .logo {
        font-size: 1.1rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: #111;
        text-decoration: none;
      }

      nav {
        display: flex;
        gap: 28px;
      }

      nav a {
        color: #555;
        text-decoration: none;
        font-size: 0.95rem;
        transition: color 0.2s;
      }

      nav a:hover {
        color: #111;
      }

      main {
        width: min(1100px, 90vw);
        margin: 0 auto;
        padding: 80px 0 120px;
      }

      article {
        max-width: 850px;
        margin: 0 auto;
      }

      :global(h1) {
        font-size: clamp(2rem, 4vw, 2.6rem);
        line-height: 1.1;
        letter-spacing: -0.035em;
        margin: 0 0 24px;
      }

      :global(h2) {
        margin-top: 64px;
        font-size: 1.7rem;
        letter-spacing: -0.02em;
      }

      :global(p) {
        color: #555;
      }

      :global(a) {
        color: inherit;
      }

      :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 24px 0 48px;
        font-size: 0.95rem;
      }

      :global(th),
      :global(td) {
        padding: 14px 16px;
        text-align: left;
        border-bottom: 1px solid #e5e5e2;
      }

      :global(th) {
        font-weight: 600;
        color: #222;
        background: #f1f1ef;
      }

      :global(td) {
        color: #555;
      }

      :global(article img) {
        max-width: 100%;
        height: auto;
      }

      :global(article p:has(img)) {
        margin: 32px 0 48px;
      }

      :global(article p:has(img) img) {
        display: block;
        margin: 0 auto;
      }

      :global(.product-photo) {
        width: 100%;
        max-width: 560px;
        margin: 0 auto;
      }

      :global(.pin-diagram) {
        width: 80%;
        max-width: 2000px;
        margin: 32px auto 48px;
      }

      :global(.bom) {
        width: 80%;
        max-width: 850px;
        margin: 32px auto 48px;
      }

      :global(.color-box) {
        display: inline-block;
        width: 100px;
        height: 22px;
        border: 1px solid #666;
      }

      :global(.in-box) {
        display: inline-block;
        padding: 0px 13px;
        border: 1px solid;
      }

      :global(.aquamarine) {
        background-color: #7fffc4;
      }

      footer {
        border-top: 1px solid #e5e5e2;
        padding: 32px 5vw;
        color: #888;
        font-size: 0.85rem;
      }

      @media (max-width: 600px) {
        header {
          padding: 0 6vw;
        }

        nav {
          gap: 16px;
        }

        main {
          padding: 55px 0 80px;
        }

        :global(table) {
          font-size: 0.9rem;
        }

        :global(th),
        :global(td) {
          padding: 11px 10px;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <a class="logo" href="/">FAIRHOG</a>

      <nav>
        <a href="/">Home</a>
        <a href={productsHref}>
          {isJapanese ? "製品" : "Products"}
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      © 2026 FAIRHOG
    </footer>
  </body>
</html>
