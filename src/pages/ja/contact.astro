---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="お問い合わせ"
  description="製品に関するお問い合わせはこちらから">

  <article>
    <h1>お問い合わせ</h1>
<p>
  For product inquiries, technical questions, or other requests,
  please use the form below.
</p>
<div class="form-container">
  <iframe
    src="/zoho-form-ja.html"
    title="Contact form"
    width="100%"
    height="800"
    frameborder="0"
    marginheight="0"
    marginwidth="0"
  >
    Loading…
  </iframe>
</div>
  </article>
</BaseLayout>

<style>
  .form-container {
    width: 100%;
    margin-top: 32px;
  }
  iframe {
    display: block;
    width: 100%;
    min-height: 800px;
    border: none;
  }
</style>